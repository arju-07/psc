# Kerala PYQ Hub — Supabase Edge Function Secrets
# Set each of these in Supabase Dashboard → Edge Functions → Secrets
# Or via CLI: supabase secrets set KEY=value

# ── Required: Gemini API for AI answer generation ──────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: OCR for scanned PDFs ─────────────────────────────────────────
# If using Google Vision API:
OCR_API_URL=https://vision.googleapis.com/v1/images:annotate
OCR_API_KEY=your_google_cloud_api_key_here

# If using a self-hosted Tesseract microservice:
# OCR_API_URL=https://your-ocr-service.com/ocr
# OCR_API_KEY=your_service_key

# ── Auto-injected by Supabase (do not set manually) ──────────────────────
# SUPABASE_URL           — your project URL
# SUPABASE_ANON_KEY      — public anon key
# SUPABASE_SERVICE_ROLE_KEY — service role key (admin access)
# JWT_SECRET             — JWT signing secret

# ── Set via CLI ───────────────────────────────────────────────────────────
# supabase secrets set GEMINI_API_KEY=your_key_here
# supabase secrets set OCR_API_KEY=your_key_here
# supabase secrets set OCR_API_URL=https://...
